---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Studio Exclusive — Predlžovanie a zahusťovanie vlasov Bratislava',
  description = 'Luxusný kadernícky salón v Bratislave. Špecialistka na neviditeľnú metódu predlžovania a zahusťovania vlasov.',
} = Astro.props;
---

<!doctype html>
<html lang="sk">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body class="bg-cream text-espresso">
    <slot />
  </body>
</html>
